---
import Button from "./Button.astro";

interface Props {
  title: string;
  description: string;
  href: string;
  ctaText: string;
  image?: string | null;
  showMedia?: boolean; // hide the media area for text-only cards
  mediaHeightClass?: string; // control media block height (e.g., 'h-56')
  mediaPlaceholderClass?: string; // control placeholder color
  className?: string; // optional wrapper classes (e.g., grid spans)
  ctaVariant?: 'minimal' | 'secondary' | 'primary';
  contentJustifyBetween?: boolean;
}

const {
  title,
  description,
  href,
  ctaText,
  image = null,
  showMedia = true,
  mediaHeightClass = 'h-56',
  mediaPlaceholderClass = 'bg-secondaryLight1',
  className,
  ctaVariant = 'minimal',
  contentJustifyBetween = false,
} = Astro.props as Props;
---

<article class:list={["border border-gray-200 overflow-hidden h-full flex flex-col", className]}>
  {showMedia && (
    <slot name="media">
      {image ? (
        <img src={image} alt={title} class={"w-full object-cover " + mediaHeightClass} />
      ) : (
        <div class:list={[mediaHeightClass, mediaPlaceholderClass]}></div>
      )}
    </slot>
  )}
  <div class:list={["p-6 flex-1 flex flex-col", contentJustifyBetween && "justify-between"]}>
    <div>
      <h4 class="text-h4 font-sans lg:text-[24px]">{title}</h4>
      <p class="text-p3 font-sans mt-2">{description}</p>
    </div>
    <Button href={href} variant={ctaVariant} showArrow className="mt-8">{ctaText}</Button>
  </div>
  
</article>


