---
import { Image } from 'astro:assets';
---

<!-- Wallet Choice Modal -->
<div id="wallet-modal" class="fixed inset-0 z-[999] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 ease-out-cubic">
  <button id="wallet-modal-backdrop" class="absolute inset-0 bg-black/30 opacity-0 transition-opacity duration-200 ease-out-cubic" aria-label="Close modal"></button>
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="wallet-modal-title"
    class="relative mx-4 w-full max-w-md rounded-2xl bg-white text-black p-5 shadow-xl ring-1 ring-black/10 transform origin-top scale-95 transition-transform duration-300 ease-out-cubic"
  >
    <div class="mb-4">
      <h2 id="wallet-modal-title" class="text-lg font-semibold">Choose how to continue</h2>
      <p class="text-sm text-neutral-500">Fastest for new users: WanderConnect.</p>
    </div>

    <div>
      <button
        id="btn-wanderconnect"
        class="w-full rounded-xl px-5 py-6 md:py-7 text-left font-medium ring-1 ring-neutral-200 bg-neutral-100 hover:bg-neutral-200 min-h-[88px] transform transition duration-150 ease-out-cubic active:scale-[0.97]"
      >
        <div class="flex items-center gap-4">
          <Image src="https://arweave.net/GWqfysg_qT-0C7-9V0pFoiTEZ-R0nRkl_LjmKgef30U" width={40} height={40} alt="Wander" />
          <div>
            <div>Continue with WanderConnect (recommended)</div>
            <div class="text-xs font-normal opacity-70">Email / social sign-in and upload.</div>
          </div>
        </div>
      </button>

      <div class="mt-4 text-xs font-medium text-neutral-600">Already have a Wallet?</div>

      <div class="mt-2 flex gap-2 flex-wrap items-stretch">
        <a
          id="btn-beacon"
          href="https://beaconwallet.app"
          target="_blank"
          rel="noreferrer"
          class="flex-1 min-w-[140px] rounded-lg px-3 py-3 text-left text-sm font-medium ring-1 ring-neutral-200 hover:bg-neutral-100 h-full transform transition duration-150 ease-out-cubic active:scale-[0.97]"
        >
          <div class="flex items-center gap-3">
            <Image src="https://arweave.net/hESR2qOaFHSDa6bPuEQDNfU7ntqmAtffVRfqAOpSm7Y" width={24} height={24} alt="Beacon" />
            <div>
              <div>Use Beacon</div>
              <div class="text-[10px] font-normal opacity-70">Connect Beacon wallet</div>
            </div>
          </div>
        </a>

        <a
          href="https://wander.app"
          target="_blank"
          rel="noreferrer"
          class="flex-1 min-w-[140px] rounded-lg px-3 py-3 text-left text-sm font-medium ring-1 ring-neutral-200 hover:bg-neutral-100 h-full transform transition duration-150 ease-out-cubic active:scale-[0.97]"
        >
          <div class="flex items-center gap-3">
            <Image src="https://arweave.net/GWqfysg_qT-0C7-9V0pFoiTEZ-R0nRkl_LjmKgef30U" width={24} height={24} alt="Wander"/>
            <div>
              <div>Use Wander</div>
              <div class="text-[10px] font-normal opacity-70">Connect Wander wallet</div>
            </div>
          </div>
        </a>

        <a
          href="https://arweave.app/connect"
          target="_blank"
          rel="noreferrer"
          class="flex-1 min-w-[140px] rounded-lg px-3 py-3 text-left text-sm font-medium ring-1 ring-neutral-200 hover:bg-neutral-100 h-full transform transition duration-150 ease-out-cubic active:scale-[0.97]"
        >
          <div class="flex items-center gap-3">
            <Image src="https://arweave.net/uzugTgdP9Wll7f3a6nIo-PFX0kCZ_5wpcKucxP45SXI" width={24} height={24} alt="Arweave.app"/>
            <div>
              <div>Use Arweave.app</div>
              <div class="text-[10px] font-normal opacity-70">Connect Arweave.app wallet</div>
            </div>
          </div>
        </a>
      </div>
    </div>

    <div class="mt-4 flex justify-end">
      <button
        id="wallet-modal-cancel"
        class="rounded-lg px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-100"
      >
        Cancel
      </button>
    </div>
  </div>
  </div>


