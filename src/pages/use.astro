---
import Layout from "../layouts/Layout.astro";
import WanderAuth from "../components/WanderAuth";
import WalletModal from "../components/WalletModal.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import FooterAlt from "../components/Footer-Alt.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
---

<Layout title="Use Arweave">
  {/* React widget to manage WanderConnect */}
  <WanderAuth client:load />
  <section class="h-[calc(100vh-103px-32px)] flex flex-col pb-12" id="use" aria-label="Use Arweave">

      <!-- Kicker -->
      <div class="text-kicker lg:text-[16px] font-mono">Use Arweave.</div>

      <!-- Headline -->
      <h1 class="text-h1 lg:text-[48px] font-sans mt-2">Store data permanently.</h1>

      <!-- Paragraph -->
      <p class="text-p1 lg:text-[14px] font-sans mt-3 max-w-4xl">
        Whether it's a personal photo or preservation of humanity's most important data, try it out with the hosting of truly decentralized and provably neutral web apps.
      </p>

      <!-- Steps Tabs -->
      <div class="mt-20 h-full flex flex-col">
        <div class="grid grid-cols-2 items-end border-b border-gray-200">
          <button data-step-tab="1" type="button"
            class="text-left font-mono text-[12px] tracking-[0.08em] py-3 pr-4 border-b">
            Step 1: Upload your file.
          </button>
          <button data-step-tab="2" type="button"
            class="text-left font-mono text-[12px] tracking-[0.08em] py-3 pl-4 text-secondaryLight2">
            Step 2: Access your file.
          </button>
        </div>

        <!-- Step 1 Panel -->
        <div data-step-panel="1" class="mt-10">
          <h3 class="text-2xl font-sans">Step 1: Upload your file.</h3>
          <p class="text-p3 font-sans mt-2">
            You can upload your file for free and access it immediately after. Make sure it's under 100kb.
          </p>

          <!-- Dropzone -->
          <div id="dropzone" class="group mt-8  w-full border-2 border-dashed border-black h-full items-center justify-center text-center cursor-pointer hover:border-orange transition duration-200 ease-out-cubic flex flex-col transform will-change-transform">
            <div class="text-orange p-8 border-dashed border-2 border-black transition-colors duration-150 ease group-hover:border-orange">
              <img src="/src/images/icons/store-icon.svg" alt="Upload" class="w-16 h-16 inline-block align-middle" />
            </div>
            <div class="mt-4 font-mono">Drag and Drop</div>
            <div class="text-secondaryLight2 text-p3">Under &lt;100KB</div>
            <div class="mt-4 text-p3">
              or <button type="button" class="underline group-hover:text-orange group-active:scale-95 transition-transform duration-150 ease" id="choose-file-btn">choose file</button> to upload
            </div>
            <div id="selected-file-name" class="mt-2 text-p3"></div>
            <div class="mt-4 flex items-center justify-center">
              <div id="upload-spinner" class="hidden h-10 w-10 rounded-full border-2 border-gray-300 border-t-black animate-spin"></div>
            </div>
            <div id="selected-file-error" class="mt-2 text-sm text-red-600 hidden"></div>
            <input id="file-input" type="file" class="hidden" />
          </div>
        </div>

        <!-- Step 2 Panel -->
        <div data-step-panel="2" class="mt-10 hidden">
          <h3 class="text-2xl font-sans">Step 2: Access your file.</h3>
          <p class="text-p3 font-sans mt-2">
            Once your file is uploaded, you can easily access it through the Wayfinder protocol on Arweave.
          </p>

          <div class="mt-8 w-full shadow-sm border border-gray-300 p-10 lg:p-16 text-center h-full flex flex-col justify-center">
            <div class="mx-auto h-24 w-24 border-2 border-gray-300 flex items-center justify-center">
              <!-- Check icon -->
              <svg id="uploaded-check" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-10 w-10 text-green-500">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div id="status-el" class="mt-4 text-p3">File Uploaded</div>

            <a id="view-link" href="#" target="_blank" rel="noopener" class="mt-6 inline-block text-orange underline font-mono">View your file on Arweave</a>

            <div class="mt-8 space-y-2 font-mono">
              <div>
                Address: <span id="address-el" class="select-all">—</span>
              </div>
              <div class="flex items-center justify-center gap-6">
                <span>Size: <span id="size-el">—</span></span>
                <span>File Type: <span id="type-el">—</span></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <WalletModal />

</section>
    <!-- Next Section: Tutorial and Resources -->

    <section class="relative pb-12 mt-20" id="resources" aria-label="Use Arweave: Examples">
       <!-- Kicker -->
       <div class="text-kicker lg:text-[16px] font-mono">Use Arweave.</div>

       <!-- Headline -->
       <h1 class="text-h1 lg:text-[48px] font-sans mt-2">Arweave is the World's Data Layer.</h1>
 
       <!-- Paragraph -->
       <p class="text-p1 lg:text-[14px] font-sans mt-3 max-w-4xl">
        Unlike traditional blockchains built for transactions, Arweave’s novel blockweave protocol was designed from the ground up as the web’s permanent data layer. With a single upfront fee, you can store data indefinitely that is tamper‑proof, censorship‑resistant, and always accessible. Below are some ways to dive in.       </p>
      <!-- Upload Tutorial card -->
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/phosphor-icons@1.4.2/src/css/icons.css" />
      <div class="border border-gray-200 p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6 mt-10 h-60 md:h-80">
        <div class="max-w-2xl h-full flex flex-col justify-between">
          <div>
            <h3 class="text-h3 font-sans lg:text-[32px]">Use Cases.</h3>
            <p class="text-p3 font-sans mt-2">
              From preserving humanity’s digital record to powering the bleeding edge foundation of AI.
            </p>
          </div>
          <div>
            <Button href="https://ar.io/https://ar.io/decentralized-ai" variant="secondary" showArrow>
              Start To Explore.
            </Button>
          </div>
        </div>
        <!-- Right-side visuals: Phosphor icons for Arweave use cases -->
        <div class="flex items-center gap-6 ml-auto">
          <div class="h-12 w-12 bg-gray-100 border border-gray-200 flex items-center justify-center">
            <i class="ph ph-cloud-arrow-up text-3xl"></i>
          </div>
          <div class="h-12 w-12 bg-gray-100 border border-gray-200 flex items-center justify-center">
            <i class="ph ph-shield-check text-3xl"></i>
          </div>
          <div class="h-12 w-12 bg-gray-100 border border-gray-200 flex items-center justify-center">
            <i class="ph ph-brain text-3xl"></i>
          </div>
        </div>
      </div>

      <!-- Remove global overlay; use per-card overlay instead -->

      <!-- Resource cards grid -->
      <div class="mt-10 grid grid-cols-1 lg:grid-cols-2 gap-8">
        <Card
          title="Read About Arweave."
          description="Dive deep into the culture and news on Arweave."
          href="https://permaweb-journal.arweave.net/"
          ctaText="Read Permaweb Journal."
          showBottomOverlay
          image="https://arweave.net/P5rMc0lbcUFqR9svc9i-69lJ30q85sJjeCVNMuJKS6U"
          itemsPosition="flex items-end justify-center"
          position="translate-y-8"
        />

        <Card
          title="Permanent Cloud Storage."
          description="Pay once, store forever with Arweave's permanent data storage."
          href="https://ardrive.io"
          ctaText="Store on ArDrive."
          showBottomOverlay
          itemsPosition="flex items-end justify-center"
          image="https://arweave.net/Aa5ZIvY8q9hHVFzeiSR06eDH71PMqhPmNVSUtXrvX8k"
          imageWidthClass="max-w-[400px]"
          position="translate-y-24"
        />

        <Card
          title="Get Wallet."
          description="Choose an Arweave wallet that suits your device compatibility and personal preferences."
          href="#"
          ctaText="Choose Your Wallet."
          showBottomOverlay
          image="https://arweave.net/KYxXmKf35Qdu4xoBDXuFqR9UnsTcNe8m2cuvl5Y0BRU"
          itemsPosition="flex items-center justify-center"
          imageWidthClass="max-w-[400px]"
        />

        <Card
          title="Smart Contracts."
          description="Create and deploy smart contracts that leverage its decentralized storage capabilities."
          href="#"
          ctaText="Develop on AO."
          showBottomOverlay
          image="https://arweave.net/O92ZbziDRxqq4mDqEDxNpC4P3wuRCgpWYQuh2zxgzXM"
          itemsPosition="flex items-end justify-center"
          position="translate-y-6"
          imageWidthClass="max-w-[400px]"

        />
      </div>


    <script>
      // @ts-nocheck
      document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('[data-step-tab]');
        const panels = document.querySelectorAll('[data-step-panel]');
        const step2Btn = document.querySelector('[data-step-tab="2"]');
        (window as any).__txReady = false;

        function setStep2Enabled(enabled) {
          if (!step2Btn) return;
          const el = step2Btn as HTMLElement;
          if (enabled) {
            el.classList.remove('opacity-50','cursor-not-allowed','pointer-events-none');
            el.setAttribute('aria-disabled','false');
          } else {
            el.classList.add('opacity-50','cursor-not-allowed','pointer-events-none');
            el.setAttribute('aria-disabled','true');
          }
        }
        setStep2Enabled(false);

        function setActive(step) {
          tabs.forEach((t) => {
            const isActive = t.getAttribute('data-step-tab') === step;
            t.classList.toggle('border-b', isActive);
            t.classList.toggle('border-black', isActive);
            t.classList.toggle('text-secondaryLight2', !isActive);
          });
          panels.forEach((p) => {
            const isPanel = p.getAttribute('data-step-panel') === step;
            if (isPanel) {
              p.classList.remove('hidden');
              p.classList.add('flex', 'flex-col', 'h-full');
            } else {
              p.classList.add('hidden');
              p.classList.remove('flex', 'flex-col', 'h-full');
            }
          });
        }

        tabs.forEach((t) =>
          t.addEventListener('click', (e) => {
            const targetStep = t.getAttribute('data-step-tab');
            if (targetStep === '2' && !(window as any).__txReady) {
              e.preventDefault();
              return;
            }
            setActive(targetStep);
          })
        );

        // File interactions
        const dz = document.getElementById('dropzone');
        const finputEl = document.getElementById('file-input');
        const chooseBtn = document.getElementById('choose-file-btn');
        const nameEl = document.getElementById('selected-file-name');



        async function setName(file) {
          if (!file) return;
          const errEl = document.getElementById('selected-file-error');
          const overLimit = file.size > 100 * 1024; // 100KB
          console.log('[Use] File selected:', { name: file.name, size: file.size, type: file.type, overLimit });
          if (errEl) {
            if (overLimit) {
              errEl.textContent = 'File must be under 100KB.';
              errEl.classList.remove('hidden');
            } else {
              errEl.textContent = '';
              errEl.classList.add('hidden');
            }
          }
          (window as any).__fileOk = !overLimit;
          if (overLimit) {
            return; // too large; do not proceed or open modal
          }
          if (nameEl) nameEl.textContent = file.name;
          // Save selected file globally for the auth/upload flow
          (window as any).__selectedFile = file;
          // Populate Step 2 details
          const linkEl = document.getElementById('view-link');
          const addr = document.getElementById('address-el');
          const sizeEl = document.getElementById('size-el');
          const typeEl = document.getElementById('type-el');
          const statusEl = document.getElementById('status-el');
          const spinnerEl = document.getElementById('upload-spinner');
          const checkEl = document.getElementById('uploaded-check');
          if (linkEl) linkEl.setAttribute('href', `#`);
          if (addr) addr.textContent = '—';
          if (sizeEl) sizeEl.textContent = `${Math.round(file.size / 1024)}kb`;
          if (typeEl) typeEl.textContent = (file.type?.split('/')[1] || file.name.split('.').pop() || 'unknown');
          if (statusEl) statusEl.textContent = 'Ready to upload';
          if (spinnerEl) spinnerEl.classList.add('hidden');
          if (checkEl) checkEl.classList.remove('hidden');
          // Do NOT switch to Step 2 yet; wait for successful transaction
        }

        if (dz && finputEl) {
          dz.addEventListener('dragover', (e) => {
            e.preventDefault();
            dz.classList.add('border-orange');
          });
          dz.addEventListener('dragleave', () => dz.classList.remove('border-orange'));
          dz.addEventListener('drop', (e) => {
            e.preventDefault();
            dz.classList.remove('border-orange');
            // Scale down briefly then back to normal on drop
            dz.classList.add('scale-[0.99]');
            setTimeout(() => {
              dz.classList.remove('scale-[0.99]');
            }, 120);
            const file = e.dataTransfer?.files?.[0];
            if (file) setName(file);
          });
          dz.addEventListener('click', () => {
            // Scale down briefly then back to normal on click
            dz.classList.add('scale-[0.99]');
            setTimeout(() => {
              dz.classList.remove('scale-[0.99]');
            }, 120);
            if (finputEl instanceof HTMLInputElement) finputEl.click();
          });
          if (chooseBtn) chooseBtn.addEventListener('click', () => {
            // Mirror the same click animation on the dropzone when using the button
            dz?.classList.add('scale-[0.99]');
            setTimeout(() => {
              dz?.classList.remove('scale-[0.99]');
            }, 120);
            if (finputEl instanceof HTMLInputElement) finputEl.click();
          });
          if (finputEl instanceof HTMLInputElement) {
            finputEl.addEventListener('change', () => setName(finputEl.files?.[0]));
          }
        }

        // Callback invoked by WanderAuth when tx is successful
        (window as any).__onTxSuccess = () => {
          (window as any).__txReady = true;
          setStep2Enabled(true);
          setActive('2');
        };

        // Initialize to Step 1
        setActive('1');
        const step1 = document.querySelector('[data-step-panel="1"]');
        if (step1) {
          step1.classList.add('flex', 'flex-col', 'h-full');
        }
      });
    </script>
    <script>
      // @ts-nocheck
      ;(function () {
        // Modal elements
        const modal = document.getElementById('wallet-modal');
        const btnPrimary = document.getElementById('btn-wanderconnect');
        const btnCancel = document.getElementById('wallet-modal-cancel');
        const backdrop = document.getElementById('wallet-modal-backdrop');

        function openModal() {
          if (!modal) return;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          // Focus primary for accessibility
          setTimeout(() => btnPrimary?.focus(), 0);
          document.addEventListener('keydown', onKeydown);
        }

        function closeModal() {
          if (!modal) return;
          modal.classList.remove('flex');
          modal.classList.add('hidden');
          document.removeEventListener('keydown', onKeydown);
        }

        function onKeydown(e) {
          if (e.key === 'Escape') closeModal();
        }

        // Hook into existing file selection pipeline:
        const finputEl = document.getElementById('file-input');

        // Patch change/drop listeners to open the modal after setName runs.
        const dz = document.getElementById('dropzone');
        function afterSetName() {
          openModal();
        }

        if (dz) {
          dz.addEventListener('drop', () => setTimeout(afterSetName, 0));
          dz.addEventListener('click', () => {
            // clicking dropzone triggers file picker; change event will handle modal
          });
        }
        if (finputEl instanceof HTMLInputElement) {
          finputEl.addEventListener('change', () => setTimeout(afterSetName, 0));
        }

        // Wire modal buttons
        btnCancel?.addEventListener('click', closeModal);
        backdrop?.addEventListener('click', closeModal);

        // WanderConnect action - delegate to React helper
        btnPrimary?.addEventListener('click', async () => {
          (window as any).__wanderConnectAndUpload?.();
        });
      })();
    </script>
  </section>
  <FooterAlt />

  <ScrollToTop threshold={800} />
</Layout>
